{$APP_DOMAIN} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # A API passa pelo BFF do Next.js: o navegador conversa apenas com o
    # frontend (mesma origem), e o frontend repassa a chamada ao backend
    # pela rede interna. O backend não é exposto publicamente.
    handle /api/* {
        reverse_proxy frontend:3000
    }

    handle /health/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
