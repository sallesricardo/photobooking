FROM python:3.13-slim

WORKDIR /app
RUN mkdir -p /app/data
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY deploy/entrypoint.sh /usr/local/bin/photobooking-entrypoint

RUN chmod +x /usr/local/bin/photobooking-entrypoint
EXPOSE 8000

ENTRYPOINT ["photobooking-entrypoint"]
